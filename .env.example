# Nusxa oling: cp .env.example .env.local  (Vercel'da: Project Settings → Environment Variables)

# PostgreSQL (Neon). Vercel → Storage → Neon ulansa DATABASE_URL va DATABASE_URL_UNPOOLED o'zi qo'shiladi.
# Lokal: postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL=
# Ixtiyoriy: migratsiya va import uchun pooler'siz ulanish (bo'lmasa DATABASE_URL ishlatiladi)
DATABASE_URL_UNPOOLED=

# BotFather bergan token. Mini App initData shu token bilan tekshiriladi
TELEGRAM_BOT_TOKEN=

# Ixtiyoriy: webhook maxfiy kaliti, 16–256 belgi (A-Z a-z 0-9 _ -). Bo'sh bo'lsa tokendan hosil qilinadi
TELEGRAM_WEBHOOK_SECRET=

# Ilovaning https manzili (oxirida / siz). Vercel'da bo'sh qolsa production domeni olinadi
APP_URL=

# Yopiq pilot. invite (sukut): faqat taklif kodi bilan kirganlar; open: hamma (mualliflar ruxsatisiz ishlatmang)
ACCESS_MODE=invite

# Admin Telegram ID'lari (vergul bilan). Botda /id yozib bilib oling. Adminlar: /invite, /invites, /disable
ADMIN_TELEGRAM_IDS=

# Faqat lokal dev: Telegram'siz kirish uchun soxta foydalanuvchi ID (production'da e'tiborsiz)
DEV_TELEGRAM_ID=
